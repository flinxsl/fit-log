<?xml version="1.0" encoding="utf-8"?>
<!--
  A loaded barbell, in the same green the app uses for a completed set.

  Everything sits inside the 66dp centre circle of the 108dp viewport, which is
  the only region an adaptive icon is guaranteed to show: the launcher may crop
  the rest to a circle, a squircle or a teardrop. Widest point here is 64dp.

  The plates are squared-off slabs rather than tall thin bars. An earlier draft
  used thin ones and the whole icon read as a letter H at 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The bar. A round-capped stroke is exactly a 64x7 pill, so no path maths. -->
    <path
        android:pathData="M25.5,54 L82.5,54"
        android:strokeColor="#00E5A0"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Left plate: 15 wide, 36 tall, 5 corner radius, spanning x 27..42, y 36..72. -->
    <path
        android:fillColor="#00E5A0"
        android:pathData="M32,36 L37,36 A5,5 0 0 1 42,41 L42,67 A5,5 0 0 1 37,72 L32,72 A5,5 0 0 1 27,67 L27,41 A5,5 0 0 1 32,36 Z" />

    <!-- Right plate: the same, spanning x 66..81. -->
    <path
        android:fillColor="#00E5A0"
        android:pathData="M71,36 L76,36 A5,5 0 0 1 81,41 L81,67 A5,5 0 0 1 76,72 L71,72 A5,5 0 0 1 66,67 L66,41 A5,5 0 0 1 71,36 Z" />
</vector>
