<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive-icon background. It must fill the whole 108x108 viewport: the
  launcher masks it to whatever shape the device uses, so anything short of the
  full square shows a gap on a circular mask.

  Dark green rather than the app's true black, because a black icon on a black
  wallpaper is a hole in the home screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:color="#FF10302A" android:offset="0.0" />
                <item android:color="#FF06100E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
